# ===========================================
# TrustTrip - Production Docker Image
# Multi-stage build for Next.js 16 application
# ===========================================

# ------------------------------------------------------------------
# STAGE 1: Dependencies
# ------------------------------------------------------------------
# Install dependencies in a clean stage for better caching
FROM node:18-alpine AS deps

# Set working directory
WORKDIR /app

# Copy package files first for better layer caching
COPY package*.json ./

# Install dependencies
# Using npm ci for deterministic installs in CI/CD
RUN npm ci

# ------------------------------------------------------------------
# STAGE 2: Builder
# ------------------------------------------------------------------
# Build the Next.js application
FROM node:18-alpine AS builder

WORKDIR /app

# Copy dependencies from deps stage
COPY --from=deps /app/node_modules ./node_modules

# Copy package files
COPY package*.json ./

# Copy application source code
COPY . .

# Set environment variables for build
ENV NEXT_TELEMETRY_DISABLED=1

# Build the Next.js application
# This creates the production build with static and dynamic pages
RUN npm run build

# ------------------------------------------------------------------
# STAGE 3: Runner
# ------------------------------------------------------------------
# Production-ready minimal image
FROM node:18-alpine AS runner

WORKDIR /app

# Set production environment
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

# Create non-root user for security
RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs

# Copy necessary files from builder stage
# Using standalone output for minimal image size
COPY --from=builder /app/public ./public
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static

# Set ownership for security
RUN chown -R nextjs:nodejs /app

# Switch to non-root user
USER nextjs

# Expose the application port
EXPOSE 3000

# Health check configuration
# Docker will use this to verify the container is healthy
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD node -e "require('http').get('http://localhost:3000/api/test', (r) => process.exit(r.statusCode === 200 ? 0 : 1))"

# Set default port environment variable
ENV PORT=3000
# Host must be set for Next.js
ENV HOSTNAME="0.0.0.0"

# Start the application
# Using node directly with the standalone server.js
CMD ["node", "server.js"]

# ===========================================
# Image Metadata Labels
# ===========================================
LABEL maintainer="TrustTrip Team"
LABEL description="TrustTrip Next.js Application Container"
LABEL version="1.0.0"
LABEL org.opencontainers.image.source="https://github.com/hasan/s63-0126-kph-fullstack-with-nextjs-trusttrip"

